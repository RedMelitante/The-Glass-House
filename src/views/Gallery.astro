---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { galleryData } from '../data/gallery.js';

const { brand, filters, items, shownCount, lb } = galleryData(Astro.props);

const PAGE = 24; // projects per "Load more" step
const chipBase = 'flex: none; display: inline-flex; align-items: center; gap: 8px; height: 44px; padding: 0 16px; border-radius: 2px; font: inherit; font-size: 14px; font-weight: 500; cursor: pointer';
const chipOn = filters.find((f) => f.on)?.style;
const chipOff = filters.find((f) => !f.on)?.style;
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <!-- ===== PAGE HEADER ===== -->
  <section style="background: #F4F7F8; border-bottom: 1px solid #D6E0E4">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(20px, 2.4cqi, 28px) clamp(20px, 4cqi, 48px) clamp(40px, 5cqi, 64px)">
      <nav aria-label="Breadcrumb" style="font-size: 13px; color: #4A5C67; margin-bottom: clamp(24px, 4cqi, 48px)"><a href="/" style="color: #4A5C67">Home</a><span style="margin: 0 8px">/</span><span aria-current="page" style="color: #0F2433; font-weight: 500">Project gallery</span></nav>
      <div style="display: flex; flex-wrap: wrap; gap: 20px 64px; align-items: flex-end; justify-content: space-between">
        <div style="flex: 1 1 560px; min-width: 0">
          <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>1K+ projects · 30+ years</div>
          <h1 style="margin: 14px 0 14px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(40px, 5.2cqi, 72px); line-height: 1.04; letter-spacing: -0.02em">Project gallery</h1>
          <p style="margin: 0; font-size: 18px; color: #26394A; max-width: 600px">Showers, mirrors, railings and storefronts we’ve designed and installed across Cape Cod, Southeastern MA and Rhode Island.</p>
        </div>
        <a href="/get-free-estimate/" style={`display: inline-flex; align-items: center; height: 52px; padding: 0 24px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px`}>Get Free Estimate</a>
      </div>
    </div>
  </section>

  <!-- ===== FILTERS + GRID ===== -->
  <section>
    <div data-filter-root data-active="All" data-gallery style="max-width: 1240px; margin: 0 auto; padding: clamp(28px, 4cqi, 48px) clamp(20px, 4cqi, 48px) clamp(64px, 9cqi, 120px)">
      <div style="display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; margin-bottom: clamp(24px, 3cqi, 36px)">
        <div role="group" aria-label="Filter by category" style="display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; max-width: 100%">
          {filters.map((f) => (<Fragment>
            <button type="button" data-filter={f.label} aria-pressed={f.on ? 'true' : 'false'} data-style-base={chipBase} data-style-on={chipOn} data-style-off={chipOff} style={`${chipBase}; ${f.style}`}>{f.label}<span style="font-size: 12px; opacity: 0.7">{f.count}</span></button>
          </Fragment>))}
        </div>
        <span style="font-size: 14px; color: #4A5C67">Showing <span data-gallery-shown>{Math.min(PAGE, shownCount)}</span> of <span data-gallery-total>{shownCount}</span></span>
      </div>

      <div style={`columns: var(--cols); column-gap: clamp(10px, 1.6cqi, 20px)`}>
        {items.map((p, i) => (<Fragment>
          <button type="button" data-filter-item data-cat={p.cat} data-gallery-item data-img={p.img} data-title={p.title} data-town={p.town} data-paged-out={i >= PAGE ? '' : undefined} aria-label={`Open ${p.title}`} style="display: block; width: 100%; break-inside: avoid; margin: 0 0 clamp(10px, 1.6cqi, 20px); padding: 0; border: 0; background: transparent; text-align: left; font: inherit; color: #0F2433; cursor: zoom-in">
            <span class="tile" style={`--hd: ${p.h}; --hm: ${Math.round(parseInt(p.h) * 0.62)}px; display: block; position: relative; height: var(--th); background-color: ${p.tone}; background-image: repeating-linear-gradient(118deg, rgba(255,255,255,0) 0 80px, rgba(255,255,255,0.3) 80px 82px); border-radius: 2px`}>
              <img src={p.img} alt={p.title} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 2px" loading="lazy" decoding="async" />
              <span style="position: absolute; right: 10px; top: 10px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.8); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px)"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#0F2433" stroke-width="1.8" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path></svg></span>
            </span>
            <span style="display: block; padding: 10px 2px 0"><span style="display: block; font-size: 15px; font-weight: 600; line-height: 1.35">{p.title}</span><span style="font-size: 13px; color: #4A5C67">{p.cat} · {p.town}</span></span>
          </button>
        </Fragment>))}
      </div>

      <div style="display: flex; justify-content: center; margin-top: 28px">
        <button type="button" data-gallery-more hidden={shownCount <= PAGE} style="height: 52px; padding: 0 28px; background: #FFFFFF; border: 1px solid #0F2433; border-radius: 2px; font: inherit; font-weight: 600; font-size: 15px; color: #0F2433; cursor: pointer">Load more projects</button>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section style="background: #0F2433; color: #FFFFFF">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 7cqi, 96px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 28px 64px; align-items: center; justify-content: space-between">
      <div style="flex: 1 1 520px; min-width: 0">
        <h2 style="margin: 0 0 12px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 4cqi, 52px); line-height: 1.1">See something you like?</h2>
        <p style="margin: 0; color: #B9C9D1; font-size: 18px">Tell us which project caught your eye and we’ll design one for your space.</p>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a href="/get-free-estimate/" style="display: inline-flex; align-items: center; height: 56px; padding: 0 28px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Get Free Estimate</a>
        <a href="tel:+15086852770" style="display: inline-flex; align-items: center; height: 56px; padding: 0 24px; border: 1px solid rgba(255,255,255,0.7); color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Call (508) 685-2770</a>
      </div>
    </div>
  </section>

  <Footer />

  <div class="dc-m">
    <div style="position: sticky; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1.35fr; gap: 8px; padding: 10px 12px 12px; background: rgba(255,255,255,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid #D6E0E4">
      <a href="tel:+15086852770" style="display: flex; align-items: center; justify-content: center; gap: 8px; height: 52px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Call now</a>
      <a href="/get-free-estimate/" style={`display: flex; align-items: center; justify-content: center; height: 52px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px`}>Get Free Estimate</a>
    </div>
  </div>

  <!-- ===== LIGHTBOX ===== -->
  <div data-lightbox hidden>
    <div role="dialog" aria-modal="true" aria-label="Project photo viewer" tabindex="-1" style="position: fixed; inset: 0; z-index: 200; background: rgba(8,20,28,0.95); color: #FFFFFF; display: flex; flex-direction: column">
      <div style="display: flex; align-items: center; justify-content: space-between; padding: 14px clamp(12px, 2cqi, 28px); gap: 16px">
        <span style="font-size: 14px; color: #B9C9D1"><span data-lb-index>1</span> / <span data-lb-count>{shownCount}</span></span>
        <span data-lb-cat style={`font-size: 14px; color: #B9C9D1; display: var(--lbCatDisplay)`}>{lb.cat}</span>
        <button type="button" data-lb-close aria-label="Close" style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: transparent; border: 1px solid rgba(255,255,255,0.3); color: #FFFFFF; cursor: pointer"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg></button>
      </div>
      <div style="flex: 1; min-height: 0; display: flex; align-items: center; gap: clamp(8px, 2cqi, 24px); padding: 0 clamp(8px, 2cqi, 28px)">
        <button type="button" data-lb-prev aria-label="Previous photo" style="flex: none; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.25); color: #FFFFFF; cursor: pointer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 6l-6 6 6 6"></path></svg></button>
        <div style="flex: 1; min-width: 0; height: 100%; max-height: 640px; display: flex; align-items: center; justify-content: center"><img data-lb-img src={lb.img} alt={lb.title} style="display: block; max-width: 100%; max-height: 100%; object-fit: contain" loading="lazy" decoding="async" /></div>
        <button type="button" data-lb-next aria-label="Next photo" style="flex: none; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.25); color: #FFFFFF; cursor: pointer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></button>
      </div>
      <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; padding: 18px clamp(16px, 4cqi, 96px) 22px">
        <div style="flex: 1 1 320px; min-width: 0">
          <div data-lb-title style="font-family: 'Newsreader', Georgia, serif; font-size: 26px; line-height: 1.2">{lb.title}</div>
          <div data-lb-meta style="font-size: 14px; color: #B9C9D1; margin-top: 4px">{lb.cat} · {lb.town}</div>
        </div>
        <a href="/get-free-estimate/" style="display: inline-flex; align-items: center; height: 48px; padding: 0 22px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px">Get a quote for something similar</a>
      </div>
    </div>
  </div>
</div>

<style>
  .tile { --th: var(--hd); }
  [data-paged-out] { display: none !important; }
  @media (max-width: 759.98px) {
    .tile { --th: var(--hm); }
  }
  .dc-root {
    --cols: 3;
    --lbCatDisplay: inline;
  }
  @media (max-width: 759.98px) {
    .dc-root {
      --cols: 2;
      --lbCatDisplay: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  const lightbox = document.querySelector<HTMLElement>('[data-lightbox]');
  if (root && lightbox) {
    const PAGE = 24;
    let limit = PAGE;
    const items = () => [...root.querySelectorAll<HTMLElement>('[data-gallery-item]')];
    const matching = () => items().filter((el) => !el.hidden);
    const shown = root.querySelector<HTMLElement>('[data-gallery-shown]')!;
    const total = root.querySelector<HTMLElement>('[data-gallery-total]')!;
    const more = root.querySelector<HTMLButtonElement>('[data-gallery-more]')!;

    // Paging: show `limit` of the projects that match the current filter.
    const page = () => {
      const list = matching();
      list.forEach((el, i) => el.toggleAttribute('data-paged-out', i >= limit));
      shown.textContent = String(Math.min(limit, list.length));
      total.textContent = String(list.length);
      more.hidden = list.length <= limit;
    };
    root.addEventListener('filterchange', () => { limit = PAGE; page(); });
    more.addEventListener('click', () => { limit += PAGE; page(); });

    // Lightbox over the projects in the current filter.
    const $ = <T extends HTMLElement>(sel: string) => lightbox.querySelector<T>(sel)!;
    let index = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      const list = matching();
      index = (i + list.length) % list.length;
      const el = list[index];
      const img = $<HTMLImageElement>('[data-lb-img]');
      img.src = el.dataset.img!;
      img.alt = el.dataset.title!;
      $('[data-lb-title]').textContent = el.dataset.title!;
      $('[data-lb-cat]').textContent = el.dataset.cat!;
      $('[data-lb-meta]').textContent = `${el.dataset.cat} · ${el.dataset.town}`;
      $('[data-lb-index]').textContent = String(index + 1);
      $('[data-lb-count]').textContent = String(list.length);
    };
    const open = (el: HTMLElement) => {
      opener = el;
      show(matching().indexOf(el));
      lightbox.hidden = false;
      document.documentElement.style.overflow = 'hidden';
      $('[role="dialog"]').focus();
    };
    const close = () => {
      lightbox.hidden = true;
      document.documentElement.style.overflow = '';
      opener?.focus();
    };
    items().forEach((el) => el.addEventListener('click', () => open(el)));
    $('[data-lb-close]').addEventListener('click', close);
    $('[data-lb-prev]').addEventListener('click', () => show(index - 1));
    $('[data-lb-next]').addEventListener('click', () => show(index + 1));
    document.addEventListener('keydown', (e) => {
      if (lightbox.hidden) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);
    });
  }
</script>
