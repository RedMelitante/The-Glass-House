---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { notFoundData } from '../data/notFound.js';

const { brand } = notFoundData(Astro.props);
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <section style="position: relative; overflow: hidden; background: #F4F7F8">
    <svg width="560" height="560" viewBox="0 0 520 520" fill="none" aria-hidden="true" style="position: absolute; right: -120px; top: -40px; opacity: 0.35"><rect x="0.5" y="0.5" width="300" height="420" stroke="#9FB4BE"></rect><rect x="160.5" y="80.5" width="300" height="420" stroke="#9FB4BE"></rect><path d="M60 380L260 180M120 440L320 240" stroke="#C79A4B"></path></svg>
    <div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(56px, 9cqi, 128px) clamp(20px, 4cqi, 48px)">
      <div style="font-family: 'Newsreader', Georgia, serif; font-size: clamp(96px, 14cqi, 200px); line-height: 0.9; color: #9C7430; font-style: italic">404</div>
      <h1 style="margin: 20px 0 14px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(34px, 4.4cqi, 56px); line-height: 1.1; max-width: 680px">This page went right through the glass.</h1>
      <p style="margin: 0 0 28px; font-size: 18px; color: #26394A; max-width: 560px">The page you’re looking for has moved or no longer exists. Try one of these instead.</p>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a href="/" style={`display: inline-flex; align-items: center; height: 52px; padding: 0 24px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px`}>Back to home</a>
        <a href="/get-free-estimate/" style="display: inline-flex; align-items: center; height: 52px; padding: 0 24px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px">Get Free Estimate</a>
      </div>
    </div>
  </section>

  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(48px, 6cqi, 80px) clamp(20px, 4cqi, 48px)">
      <h2 style="margin: 0 0 20px; font-size: 13px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: #4A5C67">Popular pages</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1px; background: #D6E0E4; border: 1px solid #D6E0E4">
        <a href="/glass-services/shower-enclosures/" style="padding: 22px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-size: 17px; font-weight: 600">Shower enclosures →</a>
        <a href="/custom-glass-products/glass-mirror-products/" style="padding: 22px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-size: 17px; font-weight: 600">Custom mirrors →</a>
        <a href="/project-gallery/" style="padding: 22px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-size: 17px; font-weight: 600">Project gallery →</a>
        <a href="/cost-guide/" style="padding: 22px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-size: 17px; font-weight: 600">Cost guide →</a>
        <a href="/glassworks-areas-we-serve/" style="padding: 22px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-size: 17px; font-weight: 600">Areas we serve →</a>
        <a href="/contact/" style="padding: 22px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-size: 17px; font-weight: 600">Contact →</a>
      </div>
    </div>
  </section>

  <Footer />
</div>
