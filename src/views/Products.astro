---
import Header from '../components/Header.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { link } from '../lib/routes';
import { productsData } from '../data/products.js';

const { brand, products, glass } = productsData(Astro.props);
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <!-- HERO -->
  <section style="background: #F4F7F8; border-bottom: 1px solid #D6E0E4">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(20px, 2.4cqi, 28px) clamp(20px, 4cqi, 48px) clamp(48px, 6cqi, 80px)">
      <nav aria-label="Breadcrumb" style="font-size: 13px; color: #4A5C67; margin-bottom: clamp(24px, 4cqi, 48px)"><a href="/" style="color: #4A5C67">Home</a><span style="margin: 0 8px">/</span><span aria-current="page" style="color: #0F2433; font-weight: 500">Custom glass products</span></nav>
      <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Custom glass products</div>
      <h1 style="margin: 14px 0 16px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(40px, 5.4cqi, 72px); line-height: 1.04; letter-spacing: -0.02em; max-width: 900px">Glass and mirror, made to your size</h1>
      <p style="margin: 0 0 clamp(28px, 4cqi, 44px); font-size: 18px; color: #26394A; max-width: 640px">Choose the glass type, edge finish and hardware. We fabricate it in Hyannis and can install it for you.</p>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; max-width: 900px">
        <a href="/get-free-estimate/" style={`display: flex; gap: 16px; align-items: center; padding: 20px 22px; background: ${brand}; color: #FFFFFF; text-decoration: none; border-radius: 2px`}>
          <span style="flex: 1"><span style="display: block; font-size: 13px; opacity: 0.85">Want it installed?</span><span style="font-size: 18px; font-weight: 600">Get Free Estimate</span></span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="/product-quote/" style="display: flex; gap: 16px; align-items: center; padding: 20px 22px; background: #FFFFFF; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; border-radius: 2px">
          <span style="flex: 1"><span style="display: block; font-size: 13px; color: #4A5C67">Know your sizes?</span><span style="font-size: 18px; font-weight: 600">Request a product quote</span></span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- PRODUCT GRID -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8cqi, 104px) clamp(20px, 4cqi, 48px)">
      <div style={`display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--cardMin), 1fr)); gap: clamp(14px, 2cqi, 28px)`}>
        {products.map((p) => (<Fragment>
          <div style="display: flex; flex-direction: column; border: 1px solid #D6E0E4; border-radius: 2px; background: #FFFFFF">
            <a href={link(p.href)} aria-label={p.name ? 'true' : 'false'} style={`display: block; overflow: hidden; height: var(--photoH); background-color: ${p.tone}; background-image: repeating-linear-gradient(118deg, rgba(255,255,255,0) 0 70px, rgba(255,255,255,0.45) 70px 72px)`}>{p.hasImg ? (<Fragment><img src={p.img} alt={p.name} style="display: block; width: 100%; height: 100%; object-fit: cover" loading="lazy" decoding="async" /></Fragment>) : null}</a>
            <div style="padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 10px; flex: 1">
              <a href={link(p.href)} style="font-family: 'Newsreader', Georgia, serif; font-size: 23px; font-weight: 500; line-height: 1.2; color: #0F2433; text-decoration: none">{p.name}</a>
              <div class="dc-d">
                <span style="display: flex; flex-wrap: wrap; gap: 6px">
                  {p.chips.map((c) => (<Fragment><span style="font-size: 12px; font-weight: 500; padding: 3px 10px; border: 1px solid #D6E0E4; border-radius: 2px">{c}</span></Fragment>))}
                </span>
              </div>
              <span style="margin-top: auto; padding-top: 6px; display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: 14px; font-weight: 600">
                <a href={link(p.href)} style={`color: ${brand}; text-decoration: none`}>Details →</a>
                <a href="/product-quote/" style="color: #0F2433">Quote</a>
              </span>
            </div>
          </div>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- MATERIALS -->
  <section style="background: #E4EEF0">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8cqi, 96px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center">
      <div style="flex: 1 1 360px; min-width: 0">
        <h2 style="margin: 0 0 12px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(30px, 3.4cqi, 44px); line-height: 1.15">See samples at the shop</h2>
        <p style="margin: 0 0 20px; color: #26394A">Glass types, edge profiles and hardware finishes are on display at 270 Communication Way, Hyannis.</p>
        <a href="/contact/" style="display: inline-flex; align-items: center; height: 48px; padding: 0 22px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px">Plan a visit</a>
      </div>
      <div style="flex: 1.4 1 460px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(100px, 1fr)); gap: 12px">
        {glass.map((g) => (<Fragment>
          <div><span style={`display: block; height: 90px; border: 1px solid #C9D6DB; background-color: ${g.fill}`}></span><span style="display: block; font-size: 14px; font-weight: 600; margin-top: 8px">{g.name}</span></div>
        </Fragment>))}
      </div>
    </div>
  </section>

  <CtaBand heading="Have a size and a space in mind?" sub="Send us the details and we’ll quote it, installed or ready for pickup." />
  <Footer />

  <div class="dc-m">
    <div style="position: sticky; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1.35fr; gap: 8px; padding: 10px 12px 12px; background: rgba(255,255,255,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid #D6E0E4">
      <a href="tel:+15086852770" style="display: flex; align-items: center; justify-content: center; height: 52px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Call now</a>
      <a href="/get-free-estimate/" style={`display: flex; align-items: center; justify-content: center; height: 52px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px`}>Get Free Estimate</a>
    </div>
  </div>
</div>

<style>
  .dc-root {
    --cardMin: 260px;
    --photoH: 200px;
  }
  @media (max-width: 759.98px) {
    .dc-root {
      --cardMin: 150px;
      --photoH: 120px;
    }
  }
</style>
