---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { link } from '../lib/routes';
import { serviceData } from '../data/service.js';

const { brand, name, icon, eyebrow, h1, lede, bullets, hero, heroAlt, introH, introP1, introP2, glance, benefitsH, benefits, optionsH, layoutsH, styles, glassH, glass, hasFin, finH, finishes, finNote, hasPhotos, photosEy, photosH, photosLink, photos, processH, faqH, faqs, steps, related, ctaH } = serviceData(Astro.props);
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <!-- ===== HERO ===== -->
  <section style="background: #F4F7F8; border-bottom: 1px solid #D6E0E4">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(20px, 2.4cqi, 28px) clamp(20px, 4cqi, 48px) clamp(48px, 7cqi, 96px)">
      <nav aria-label="Breadcrumb" style="font-size: 13px; color: #4A5C67; margin-bottom: clamp(24px, 4cqi, 48px)"><a href="/" style="color: #4A5C67">Home</a><span style="margin: 0 8px">/</span><a href="/glass-services/" style="color: #4A5C67">Services</a><span style="margin: 0 8px">/</span><span aria-current="page" style="color: #0F2433; font-weight: 500">{name}</span></nav>
      <div style="display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: center">
        <div style="flex: 1 1 480px; min-width: 0">
          <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>{eyebrow}</div>
          <h1 style="margin: 16px 0 20px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(40px, 5.2cqi, 72px); line-height: 1.04; letter-spacing: -0.02em">{h1}</h1>
          <p style="margin: 0 0 24px; font-size: clamp(17px, 1.4cqi, 19px); color: #26394A; max-width: 540px">{lede}</p>
          <ul style="list-style: none; margin: 0 0 32px; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 16px">
            {bullets.map((t) => (<Fragment>
              <li style="display: flex; gap: 10px; align-items: center"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="2" aria-hidden="true" style="flex: none"><path d="M20 6L9 17l-5-5"></path></svg>{t}</li>
            </Fragment>))}
          </ul>
          <div style="display: flex; flex-wrap: wrap; gap: 12px">
            <a href="#estimate" style={`display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 28px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px`}>Get Free Estimate <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
            <a href="tel:+15086852770" style="display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 24px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">(508) 685-2770</a>
          </div>
        </div>
        <div style="flex: 1 1 460px; min-width: 0; position: relative">
          <img src={hero} alt={heroAlt} style="display: block; width: 100%; aspect-ratio: 5 / 4; object-fit: cover; object-position: 50% 45%" fetchpriority="high" decoding="async" />
          <div style="position: absolute; left: 16px; bottom: 16px; padding: 14px 18px; background: rgba(255,255,255,0.86); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.7); display: flex; gap: 14px; align-items: center">
            <span style="font-family: 'Newsreader', Georgia, serif; font-size: 34px; line-height: 1">1K+</span>
            <span style="font-size: 13px; color: #4A5C67; line-height: 1.4">projects across<br />Cape Cod &amp; RI</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== INTRO ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 40px 80px; align-items: flex-start">
      <div style="flex: 1.4 1 520px; min-width: 0">
        <h2 style="margin: 0 0 24px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">{introH}</h2>
        <p style="margin: 0 0 16px; font-size: 18px; color: #26394A">{introP1}</p>
        <p style="margin: 0; color: #4A5C67">{introP2}</p>
      </div>
      <aside style="flex: 1 1 340px; min-width: 0; border: 1px solid #D6E0E4; padding: 28px">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #4A5C67; margin-bottom: 8px">At a glance</div>
        <dl style="margin: 0">
          {glance.map((g) => (<Fragment>
            <div style={`display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: ${g.bb}`}><dt style="color: #4A5C67">{g.k}</dt><dd style="margin: 0; font-weight: 600; text-align: right">{g.v}</dd></div>
          </Fragment>))}
        </dl>
      </aside>
    </div>
  </section>

  <!-- ===== BENEFITS ===== -->
  <section style="background: #E4EEF0">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8cqi, 104px) clamp(20px, 4cqi, 48px)">
      <h2 style="margin: 0 0 clamp(32px, 4cqi, 48px); font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">{benefitsH}</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: clamp(24px, 3cqi, 40px)">
        {benefits.map((b) => (<Fragment>
          <div style="display: flex; flex-direction: column; gap: 12px; border-top: 1px solid #0F2433; padding-top: 20px">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="1.4" aria-hidden="true"><path d={b.d}></path></svg>
            <div style="font-size: 18px; font-weight: 600; line-height: 1.3">{b.title}</div>
            <div style="font-size: 15px; color: #4A5C67; line-height: 1.55">{b.text}</div>
          </div>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== STYLES & OPTIONS ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Styles &amp; options</div>
      <h2 style="margin: 14px 0 clamp(32px, 4cqi, 48px); font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">{optionsH}</h2>

      <h3 style="margin: 0 0 20px; font-size: 19px; font-weight: 600">{layoutsH}</h3>
      <div style={`display: grid; grid-template-columns: repeat(auto-fit, minmax(var(--styleMin), 1fr)); gap: clamp(12px, 2cqi, 24px); margin-bottom: clamp(48px, 6cqi, 72px)`}>
        {styles.map((s) => (<Fragment>
          <div style="display: flex; flex-direction: column; border: 1px solid #D6E0E4; border-radius: 2px">
            {s.hasImg ? (<Fragment>
              <img src={s.img} alt={s.name} style="display: block; width: 100%; height: clamp(160px, 20cqi, 260px); object-fit: cover; object-position: 50% 40%" loading="lazy" decoding="async" />
            </Fragment>) : null}
            {s.noImg ? (<Fragment>
              <span style={`display: flex; align-items: center; justify-content: center; width: 100%; height: clamp(160px, 20cqi, 260px); background: #E4EEF0; color: ${brand}`}><svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d={icon}></path></svg></span>
            </Fragment>) : null}
            <span style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 4px">
              <span style="font-family: 'Newsreader', Georgia, serif; font-size: 22px; font-weight: 500; line-height: 1.2">{s.name}</span>
              <span style="font-size: 14px; color: #4A5C67; line-height: 1.5">{s.text}</span>
            </span>
          </div>
        </Fragment>))}
      </div>

      <div style="display: flex; flex-wrap: wrap; gap: 48px 64px">
        <div style="flex: 1 1 420px; min-width: 0">
          <h3 style="margin: 0 0 20px; font-size: 19px; font-weight: 600">{glassH}</h3>
          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 12px">
            {glass.map((g) => (<Fragment>
              <div style="display: flex; flex-direction: column; gap: 8px">
                <span style={`height: 88px; border: 1px solid #C9D6DB; background-color: ${g.fill}; background-image: ${g.texture}`}></span>
                <span style="font-size: 15px; font-weight: 600; line-height: 1.3">{g.name}</span>
                <span style="font-size: 13px; color: #4A5C67; line-height: 1.4">{g.text}</span>
              </div>
            </Fragment>))}
          </div>
        </div>
        {hasFin ? (<Fragment>
        <div style="flex: 1 1 420px; min-width: 0">
          <h3 style="margin: 0 0 20px; font-size: 19px; font-weight: 600">{finH}</h3>
          <div style="display: flex; flex-direction: column; border-top: 1px solid #D6E0E4">
            {finishes.map((f) => (<Fragment>
              <div style="display: flex; align-items: center; gap: 16px; padding: 12px 0; border-bottom: 1px solid #D6E0E4">
                <span style={`width: 40px; height: 40px; border-radius: 50%; flex: none; background: ${f.hex}; border: 1px solid rgba(15,36,51,0.15)`}></span>
                <span style="flex: 1; font-size: 16px; font-weight: 500">{f.name}</span>
                <span style="font-size: 13px; color: #4A5C67">{f.note}</span>
              </div>
            </Fragment>))}
          </div>
          <p style="margin: 16px 0 0; font-size: 14px; color: #4A5C67">{finNote}</p>
        </div>
        </Fragment>) : null}
      </div>
    </div>
  </section>

  <!-- ===== PROJECT PHOTOS ===== -->
  {hasPhotos ? (<Fragment>
  <section style="background: #F4F7F8">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <div style="display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: flex-end; justify-content: space-between; margin-bottom: clamp(28px, 4cqi, 44px)">
        <div>
          <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>{photosEy}</div>
          <h2 style="margin: 14px 0 0; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">{photosH}</h2>
        </div>
        <a href="/project-gallery/" style={`display: inline-flex; align-items: center; gap: 8px; height: 44px; color: ${brand}; text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid currentColor`}>{photosLink}</a>
      </div>
      <div style={`display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--photoMin), 1fr)); gap: clamp(8px, 1.4cqi, 16px)`}>
        {photos.map((p) => (<Fragment>
          <a href="/project-gallery/" style={`display: block; position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 2px; background-color: ${p.tone}; background-image: repeating-linear-gradient(118deg, rgba(255,255,255,0) 0 70px, rgba(255,255,255,0.3) 70px 72px); color: #FFFFFF; text-decoration: none`}>
            <img src={p.img} alt={`${p.title}, ${p.town}`} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover" loading="lazy" decoding="async" />
            <span style="position: absolute; left: 10px; right: 10px; bottom: 10px; padding: 10px 12px; background: rgba(15,36,51,0.55); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.25); font-size: 13px"><strong style="display: block; font-size: 14px; font-weight: 600">{p.title}</strong>{p.town}</span>
          </a>
        </Fragment>))}
      </div>
    </div>
  </section>
  </Fragment>) : null}

  <!-- ===== PROCESS ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>How it works</div>
      <h2 style="margin: 14px 0 clamp(32px, 4cqi, 56px); font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">{processH}</h2>
      <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 0">
        {steps.map((s) => (<Fragment>
          <li style="padding: 28px 28px 28px 0; border-top: 2px solid #0F2433; margin-right: 24px">
            <div style="font-family: 'Newsreader', Georgia, serif; font-size: 52px; line-height: 1; color: #9C7430; margin-bottom: 18px">{s.n}</div>
            <div style="font-size: 19px; font-weight: 600; margin-bottom: 8px">{s.title}</div>
            <div style="font-size: 15px; color: #4A5C67; line-height: 1.55">{s.text}</div>
          </li>
        </Fragment>))}
      </ol>
    </div>
  </section>

  <!-- ===== FAQ ===== -->
  <section style="background: #F4F7F8">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 32px 80px">
      <div style="flex: 1 1 300px; min-width: 0">
        <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>FAQ</div>
        <h2 style="margin: 14px 0 16px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">{faqH}</h2>
        <p style="margin: 0 0 20px; color: #4A5C67">Don’t see yours? Orny is happy to talk it through.</p>
        <a href="tel:+15086852770" style="display: inline-flex; align-items: center; height: 48px; padding: 0 22px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px">Call (508) 685-2770</a>
      </div>
      <div style="flex: 2 1 520px; min-width: 0; border-top: 1px solid #C9D6DB">
        {faqs.map((q, i) => (<Fragment>
          <div style="border-bottom: 1px solid #C9D6DB">
            <button type="button" data-disclosure data-disclosure-group="faq" aria-controls={`faq-${i}`} aria-expanded={q.open ? 'true' : 'false'} data-icon-open="M5 12h14" data-icon-closed="M12 5v14M5 12h14" style="width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 0; background: transparent; border: 0; font: inherit; font-size: 18px; font-weight: 600; color: #0F2433; text-align: left; cursor: pointer">{q.q}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="1.8" aria-hidden="true" style="flex: none"><path data-disclosure-icon d={q.icon}></path></svg></button>
            <p id={`faq-${i}`} hidden={!q.open} style="margin: 0; padding: 0 40px 24px 0; color: #4A5C67; font-size: 16px; line-height: 1.65">{q.a}</p>
          </div>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== RELATED SERVICES ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <h2 style="margin: 0 0 clamp(28px, 4cqi, 44px); font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(30px, 3.2cqi, 40px); line-height: 1.15">Related services</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1px; background: #D6E0E4; border: 1px solid #D6E0E4">
        {related.map((s) => (<Fragment>
          <a href={link(s.href)} style="display: flex; flex-direction: column; gap: 12px; padding: 28px; background: #FFFFFF; color: #0F2433; text-decoration: none">
            <span style={`width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; background: #E4EEF0; color: ${brand}`}><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d={s.d}></path></svg></span>
            <span style="font-size: 19px; font-weight: 600">{s.name}</span>
            <span style="font-size: 15px; color: #4A5C67; line-height: 1.55">{s.blurb}</span>
            <span style={`font-size: 14px; font-weight: 600; color: ${brand}`}>Learn more →</span>
          </a>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== ESTIMATE CTA + FORM ===== -->
  <section id="estimate" style="background: #0F2433; color: #FFFFFF">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8cqi, 112px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 40px 80px; align-items: center">
      <div style="flex: 1 1 440px; min-width: 0">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #B9C9D1">Free estimate</div>
        <h2 style="margin: 14px 0 16px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(34px, 4.2cqi, 56px); line-height: 1.1; letter-spacing: -0.01em">{ctaH}</h2>
        <p style="margin: 0 0 28px; color: #B9C9D1; font-size: 18px">Send a few details and we’ll set up your free on-site consultation.</p>
        <a href="tel:+15086852770" style="display: inline-flex; align-items: center; gap: 12px; color: #FFFFFF; text-decoration: none"><span style="width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,0.4)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg></span><span><span style="display: block; font-size: 13px; color: #B9C9D1">Or call us</span><span style="font-family: 'Newsreader', Georgia, serif; font-size: 28px; line-height: 1.1">(508) 685-2770</span></span></a>
      </div>
      <form name="service-estimate" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" style="flex: 1 1 440px; min-width: 0; box-sizing: border-box; padding: clamp(24px, 3cqi, 36px); background: #FFFFFF; color: #0F2433; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px">
        <input type="hidden" name="form-name" value="service-estimate" /><p hidden><label>Leave this empty <input name="bot-field" /></label></p>
        <div style="display: flex; flex-direction: column; gap: 6px">
          <label for="s-name" style="font-size: 14px; font-weight: 600">Full name</label>
          <input id="s-name" name="name" type="text" required autocomplete="name" style="height: 52px; padding: 0 16px; border: 1px solid #B7C6CD; border-radius: 2px; font: inherit; font-size: 16px; color: #0F2433" />
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px">
          <label for="s-phone" style="font-size: 14px; font-weight: 600">Phone</label>
          <input id="s-phone" name="phone" type="tel" required autocomplete="tel" style="height: 52px; padding: 0 16px; border: 1px solid #B7C6CD; border-radius: 2px; font: inherit; font-size: 16px; color: #0F2433" />
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px; grid-column: 1 / -1">
          <label for="s-town" style="font-size: 14px; font-weight: 600">Town</label>
          <select id="s-town" name="town" style="height: 52px; padding: 0 14px; border: 1px solid #B7C6CD; border-radius: 2px; font: inherit; font-size: 16px; color: #0F2433; background: #FFFFFF"><option>Select your town</option><option>Hyannis</option><option>Chatham</option><option>Falmouth</option></select>
        </div>
        <label style="grid-column: 1 / -1; display: flex; gap: 12px; align-items: flex-start; font-size: 12.5px; line-height: 1.5; color: #4A5C67"><input type="checkbox" name="sms_consent" value="yes" style={`width: 20px; height: 20px; margin: 1px 0 0; flex: none; accent-color: ${brand}`} /><span>Text me about my estimate. I agree to receive SMS from The Glass House; msg frequency varies, msg &amp; data rates may apply. Reply STOP to opt out. Consent isn’t required to purchase. <a href="/privacy-policy/" style={`color: ${brand}`}>Privacy</a></span></label>
        <button type="submit" style={`grid-column: 1 / -1; height: 56px; background: ${brand}; color: #FFFFFF; border: 0; border-radius: 2px; font: inherit; font-weight: 600; font-size: 16px; cursor: pointer`}>Request My Free Estimate</button>
      </form>
    </div>
  </section>

  <Footer />

  <div class="dc-m">
    <div style="position: sticky; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1.35fr; gap: 8px; padding: 10px 12px 12px; background: rgba(255,255,255,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid #D6E0E4">
