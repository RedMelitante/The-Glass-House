---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { link } from '../lib/routes';
import { homeData } from '../data/home.js';
import type { Card } from '../lib/blog';

interface Props {
  /** The three newest blog posts. */
  latest: Card[];
}

const { latest } = Astro.props;
const { brand, filters, gallery, trusted, services, whys, towns, moreTowns, reviews } = homeData();

// Filter chip styles (the design swaps these inline when a chip is picked).
const chipBase = 'flex: none; height: 40px; padding: 0 16px; border-radius: 2px; font: inherit; font-size: 14px; font-weight: 500; cursor: pointer';
const chipOn = filters.find((f) => f.on)?.style;
const chipOff = filters.find((f) => !f.on)?.style;
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <!-- ===== HERO ===== -->
  <section style="position: relative; overflow: hidden; background-color: #2C4250; color: #FFFFFF">
    <img src="/images/orleans-area-hero.webp" alt="Waterfront living room with sliding glass doors and a frameless glass railing" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 55% 50%" fetchpriority="high" decoding="async" />
    <div aria-hidden="true" style="position: absolute; inset: 0; background: linear-gradient(90deg, rgba(10,26,38,0.84) 0%, rgba(10,26,38,0.58) 50%, rgba(10,26,38,0.18) 100%)"></div>
    <div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(48px, 9cqi, 128px) clamp(20px, 4cqi, 48px) clamp(40px, 8cqi, 112px); display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: center">
      <div style="flex: 1 1 520px; min-width: 0">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #DCE6EA">Hyannis · Cape Cod · Family-owned 30+ years</div>
        <h1 style="margin: 18px 0 20px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(42px, 6.2cqi, 84px); line-height: 1.03; letter-spacing: -0.02em">Custom glass,<br />made for <em style="font-style: italic">Cape Cod</em> homes.</h1>
        <p style="margin: 0 0 32px; font-size: clamp(17px, 1.5cqi, 20px); line-height: 1.6; color: #E6EEF1; max-width: 540px">Frameless showers, mirrors, railings and storefronts, designed, fabricated and installed by our own team for homeowners, builders and architects.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px">
          <a href="#estimate" style="display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 28px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Get Free Estimate <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
          <a href="tel:+15086852770" style="display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 24px; color: #FFFFFF; border: 1px solid rgba(255,255,255,0.7); text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>(508) 685-2770</a>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 8px 22px; margin-top: 32px; font-size: 14px; color: #DCE6EA">
          <span style="display: inline-flex; align-items: center; gap: 8px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>Licensed &amp; insured</span>
          <span style="display: inline-flex; align-items: center; gap: 8px"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6L9 17l-5-5"></path></svg>Free design consultation</span>
          <span style="display: inline-flex; align-items: center; gap: 8px"><svg width="16" height="16" viewBox="0 0 24 24" fill="#C79A4B" aria-hidden="true"><path d="M12 2l3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1z"></path></svg>5.0 on Google</span>
        </div>
      </div>

      <!-- Glass estimate card -->
      <form name="quick-estimate" method="POST" action="/thank-you/" data-netlify="true" netlify-honeypot="bot-field" id="estimate" style="flex: 0 1 420px; min-width: 0; box-sizing: border-box; padding: clamp(24px, 3cqi, 36px); background: rgba(255,255,255,0.88); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid rgba(255,255,255,0.7); box-shadow: 0 1px 0 rgba(255,255,255,0.9) inset, 0 40px 80px -40px rgba(5,15,22,0.7); color: #0F2433; display: flex; flex-direction: column; gap: 16px">
        <input type="hidden" name="form-name" value="quick-estimate" /><p hidden><label>Leave this empty <input name="bot-field" /></label></p>
        <div style="display: flex; align-items: center; gap: 14px">
          <img src="/images/orny-beltrame.webp" alt="Orny Beltrame" style="width: 60px; height: 60px; flex: none; border-radius: 50%; object-fit: cover; object-position: 50% 12%; background: #E4EEF0; border: 1px solid #D6E0E4" fetchpriority="high" decoding="async" />
          <div>
            <div style="font-family: 'Newsreader', Georgia, serif; font-size: 28px; line-height: 1.15">Get your free estimate</div>
            <div style="font-size: 14px; color: #4A5C67; margin-top: 2px">Orny will call you back promptly.</div>
          </div>
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px">
          <label for="h-name" style="font-size: 14px; font-weight: 600">Full name</label>
          <input id="h-name" name="name" type="text" required autocomplete="name" placeholder="Jane Smith" style="height: 52px; padding: 0 16px; border: 1px solid #B7C6CD; border-radius: 2px; font: inherit; font-size: 16px; background: #FFFFFF; color: #0F2433" />
        </div>
        <div style="display: flex; flex-direction: column; gap: 6px">
          <label for="h-phone" style="font-size: 14px; font-weight: 600">Phone</label>
          <input id="h-phone" name="phone" type="tel" required autocomplete="tel" placeholder="(508) 555-0123" style="height: 52px; padding: 0 16px; border: 1px solid #B7C6CD; border-radius: 2px; font: inherit; font-size: 16px; background: #FFFFFF; color: #0F2433" />
        </div>
        <label style="display: flex; gap: 12px; align-items: flex-start; font-size: 12.5px; line-height: 1.5; color: #4A5C67"><input type="checkbox" name="sms_consent" value="yes" style={`width: 20px; height: 20px; margin: 1px 0 0; flex: none; accent-color: ${brand}`} /><span>Text me about my estimate. I agree to receive SMS from The Glass House; msg frequency varies, msg &amp; data rates may apply. Reply STOP to opt out. Consent isn’t required to purchase. <a href="/privacy-policy/" style={`color: ${brand}`}>Privacy</a></span></label>
        <button type="submit" style={`height: 56px; background: ${brand}; color: #FFFFFF; border: 0; border-radius: 2px; font: inherit; font-weight: 600; font-size: 16px; cursor: pointer`}>Request My Free Estimate</button>
        <div style="font-size: 13px; color: #4A5C67; text-align: center">Prefer to talk? <a href="tel:+15086852770" style="color: #0F2433; font-weight: 600">(508) 685-2770</a></div>
      </form>
    </div>
    <div style="position: absolute; right: 16px; bottom: 12px; font-size: 12px; color: rgba(255,255,255,0.85)">Sliding glass &amp; frameless railing · Cape Cod waterfront home</div>
  </section>

  <!-- ===== TRUSTED BY ===== -->
  <section style="border-bottom: 1px solid #D6E0E4">
    <div style="max-width: 1240px; margin: 0 auto; padding: 36px clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; align-items: center; gap: 20px 40px">
      <div style="flex: 0 1 200px; font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #4A5C67; line-height: 1.5">Trusted by Cape builders, architects &amp; businesses</div>
      <div style="flex: 1 1 600px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(104px, 1fr)); gap: 16px">
        {trusted.map((t) => (<Fragment>
          <div style="height: 76px; display: flex; align-items: center; justify-content: center; padding: 6px; box-sizing: border-box"><img src={t.img} alt={t.name} style="max-width: 100%; max-height: 64px; object-fit: contain; display: block" loading="lazy" decoding="async" /></div>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== WHO WE ARE ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 48px 80px; align-items: center">
      <div style="flex: 1 1 440px; min-width: 0; position: relative; height: clamp(340px, 42cqi, 540px)">
        <img src="/images/glass-repair-in-providence-ri.webp" alt="Waterfront kitchen with floor-to-ceiling sliding glass overlooking a Cape Cod harbor" style="position: absolute; left: 0; top: 0; width: 78%; height: 82%; object-fit: cover" loading="lazy" decoding="async" />
        <img src="/images/framed-vanity-mirror.webp" alt="Wine bar with an all-glass wine room and glass bar top" style="position: absolute; right: 0; bottom: 0; width: 50%; height: 50%; object-fit: cover; border: 8px solid #FFFFFF; box-sizing: border-box" loading="lazy" decoding="async" />
      </div>
      <div style="flex: 1 1 460px; min-width: 0">
        <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Who we are</div>
        <h2 style="margin: 14px 0 20px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">A family glass shop that’s been part of the Cape for three decades.</h2>
        <p style="margin: 0 0 16px; font-size: 18px; color: #26394A">From a single bathroom mirror to a full storefront, we handle design, measuring, fabrication and installation, so one local team is accountable from first visit to final clean.</p>
        <p style="margin: 0 0 36px; color: #4A5C67">Homeowners call us for the details. Builders and architects keep calling because we show up when we say we will.</p>
        <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid #D6E0E4">
          <div style="padding: 20px 16px 0 0"><div style="font-family: 'Newsreader', Georgia, serif; font-size: clamp(40px, 4.4cqi, 56px); line-height: 1; color: #0F2433">30+</div><div style="font-size: 14px; color: #4A5C67; margin-top: 8px">Years in business</div></div>
          <div style="padding: 20px 16px 0; border-left: 1px solid #D6E0E4"><div style="font-family: 'Newsreader', Georgia, serif; font-size: clamp(40px, 4.4cqi, 56px); line-height: 1; color: #0F2433">1K+</div><div style="font-size: 14px; color: #4A5C67; margin-top: 8px">Projects completed</div></div>
          <div style="padding: 20px 0 0 16px; border-left: 1px solid #D6E0E4"><div style="font-family: 'Newsreader', Georgia, serif; font-size: clamp(40px, 4.4cqi, 56px); line-height: 1; color: #0F2433">19</div><div style="font-size: 14px; color: #4A5C67; margin-top: 8px">Towns served</div></div>
        </div>
        <a href="/about-us-glass-installation/" style={`display: inline-flex; align-items: center; gap: 8px; margin-top: 36px; height: 44px; color: ${brand}; text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid currentColor`}>Our story <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES ===== -->
  <section style="background: #F4F7F8">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <div style="display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: flex-end; justify-content: space-between; margin-bottom: clamp(32px, 4cqi, 56px)">
        <div style="flex: 1 1 520px; min-width: 0">
          <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Services</div>
          <h2 style="margin: 14px 0 0; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">What we design &amp; install</h2>
        </div>
        <a href="/glass-services/" style={`display: inline-flex; align-items: center; gap: 8px; height: 44px; color: ${brand}; text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid currentColor`}>All 12 services <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      </div>
      <div class="dc-d">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1px; background: #D6E0E4; border: 1px solid #D6E0E4">
          {services.map((s) => (<Fragment>
            <a href={link(s.href)} style="display: flex; flex-direction: column; gap: 14px; padding: 32px; background: #FFFFFF; color: #0F2433; text-decoration: none">
              <span style={`width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: #E4EEF0; color: ${brand}`}><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true"><path d={s.d}></path></svg></span>
              <span style="font-size: 20px; font-weight: 600; margin-top: 6px">{s.name}</span>
              <span style="font-size: 15px; color: #4A5C67; line-height: 1.55; flex: 1">{s.blurb}</span>
              <span style={`display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: ${brand}`}>Learn more <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
            </a>
          </Fragment>))}
        </div>
      </div>
      <div class="dc-m">
        <div style="display: flex; flex-direction: column; border-top: 1px solid #D6E0E4">
          {services.map((s) => (<Fragment>
            <a href={link(s.href)} style="display: flex; align-items: center; gap: 14px; padding: 14px 0; border-bottom: 1px solid #D6E0E4; color: #0F2433; text-decoration: none">
              <span style={`width: 48px; height: 48px; flex: none; display: flex; align-items: center; justify-content: center; background: #FFFFFF; border: 1px solid #D6E0E4; color: ${brand}`}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d={s.d}></path></svg></span>
              <span style="flex: 1; font-size: 17px; font-weight: 600">{s.name}</span>
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="1.8" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
            </a>
          </Fragment>))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONSULTANT ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 40px 80px; align-items: center">
      <div style="flex: 0 1 460px; min-width: 0; position: relative">
        <img src="/images/orny-beltrame-in-the-glass-house-showroom-with-glass.webp" alt="Orny Beltrame in The Glass House showroom with glass hardware samples" style="display: block; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%" loading="lazy" decoding="async" />
        <div style="position: absolute; left: 20px; right: 20px; bottom: -28px; padding: 16px 20px; background: #FFFFFF; border: 1px solid #D6E0E4; display: flex; align-items: center; gap: 14px">
          <span style="font-family: 'Newsreader', Georgia, serif; font-size: 40px; line-height: 1; color: #9C7430">25+</span>
          <span style="font-size: 14px; color: #4A5C67; line-height: 1.4">years designing &amp; installing custom glass</span>
        </div>
      </div>
      <div style="flex: 1 1 460px; min-width: 0; padding-top: 24px">
        <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Meet your consultant</div>
        <h2 style="margin: 14px 0 6px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(36px, 4cqi, 56px); line-height: 1.1; letter-spacing: -0.01em">Orny Beltrame</h2>
        <div style="font-size: 16px; font-weight: 600; color: #4A5C67; margin-bottom: 24px">Project &amp; Design Consultant</div>
        <p style="margin: 0 0 16px; font-size: 18px; color: #26394A">Orny is the person who comes to your home or job site. He measures, talks through glass, hardware and finish options, and puts together a clear written quote, before anything is ordered.</p>
        <p style="margin: 0 0 32px; color: #4A5C67">Builders and architects get one direct contact from first sketch to final install.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 12px">
          <a href="#estimate" style={`display: inline-flex; align-items: center; height: 52px; padding: 0 24px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px`}>Book a free consultation</a>
          <a href="mailto:ornyb@theghglass.com" style="display: inline-flex; align-items: center; gap: 8px; height: 52px; padding: 0 20px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px">ornyb@theghglass.com</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== WHY CHOOSE US ===== -->
  <section style="background: #E4EEF0">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8cqi, 104px) clamp(20px, 4cqi, 48px)">
      <h2 style="margin: 0 0 clamp(32px, 4cqi, 48px); font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em; max-width: 720px">Why Cape homeowners and builders choose us</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: clamp(24px, 3cqi, 40px)">
        {whys.map((w) => (<Fragment>
          <div style="display: flex; flex-direction: column; gap: 12px; border-top: 1px solid #0F2433; padding-top: 20px">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="1.4" aria-hidden="true"><path d={w.d}></path></svg>
            <div style="font-size: 18px; font-weight: 600; line-height: 1.3">{w.title}</div>
            <div style="font-size: 15px; color: #4A5C67; line-height: 1.55">{w.text}</div>
          </div>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== AREAS ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <div style="display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: flex-end; justify-content: space-between; margin-bottom: clamp(32px, 4cqi, 56px)">
        <div style="flex: 1 1 560px; min-width: 0">
          <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Areas we serve</div>
          <h2 style="margin: 14px 0 12px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">From Bourne to Provincetown, and over the bridge</h2>
          <p style="margin: 0; color: #4A5C67; font-size: 17px">Based in Hyannis, serving all of Barnstable County, Southeastern Massachusetts and select areas of Rhode Island.</p>
        </div>
        <a href="/glassworks-areas-we-serve/" style={`display: inline-flex; align-items: center; gap: 8px; height: 44px; color: ${brand}; text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid currentColor`}>All 19 areas <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
      </div>
      <div style={`display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--townMin), 1fr)); gap: clamp(10px, 2cqi, 20px)`}>
        {towns.map((t) => (<Fragment>
          <a href={link(t.href)} style="display: flex; flex-direction: column; border: 1px solid #D6E0E4; border-radius: 2px; color: #0F2433; text-decoration: none; background: #FFFFFF">
            {t.show ? (<Fragment>
              <img src={t.img} alt={t.name} style={`display: block; width: 100%; height: var(--townImgH); object-fit: cover`} loading="lazy" decoding="async" />
            </Fragment>) : null}
            <span style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 2px">
              <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #4A5C67">{t.region}</span>
              <span style="display: flex; justify-content: space-between; align-items: center; gap: 8px"><span style="font-family: 'Newsreader', Georgia, serif; font-size: 24px; font-weight: 500">{t.name}</span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
            </span>
          </a>
        </Fragment>))}
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px">
        <span style="font-size: 14px; color: #4A5C67; margin-right: 6px; align-self: center">Also serving:</span>
        {moreTowns.map((t) => (<Fragment>
          <a href={link(t.href)} style="display: inline-flex; align-items: center; height: 36px; padding: 0 14px; border: 1px solid #D6E0E4; border-radius: 2px; font-size: 14px; color: #0F2433; text-decoration: none">{t.name}</a>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== GALLERY ===== -->
  <section style="background: #F4F7F8">
