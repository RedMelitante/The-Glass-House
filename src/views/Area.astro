---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { link } from '../lib/routes';
import { areaData } from '../data/area.js';

const { brand, services, town, hero, lede, consult, introH, intro, drive, local, statNum, statLabel, villages, regionThe, mapX, mapY, projects, reviews, nearby } = areaData(Astro.props);
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <!-- ===== LOCAL HERO ===== -->
  <section style={`position: relative; background-color: #3A5462; background-image: linear-gradient(90deg, rgba(15,36,51,0.82) 0%, rgba(15,36,51,0.45) 60%, rgba(15,36,51,0.15) 100%), url(${hero}); background-size: cover; background-position: 50% 30%; color: #FFFFFF`}>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(24px, 3cqi, 32px) clamp(20px, 4cqi, 48px) clamp(48px, 8cqi, 104px)">
      <nav aria-label="Breadcrumb" style="font-size: 13px; color: #DCE6EA; margin-bottom: clamp(32px, 6cqi, 72px)"><a href="/" style="color: #DCE6EA">Home</a><span style="margin: 0 8px">/</span><a href="/glassworks-areas-we-serve/" style="color: #DCE6EA">Areas we serve</a><span style="margin: 0 8px">/</span><span aria-current="page" style="color: #FFFFFF; font-weight: 500">{town}</span></nav>
      <div style="display: flex; flex-wrap: wrap; gap: 40px 64px; align-items: center">
        <div style="flex: 1 1 520px; min-width: 0">
          <div style="display: inline-flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: #DCE6EA"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path></svg>Serving {town}, MA · Lower Cape</div>
          <h1 style="margin: 16px 0 20px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(40px, 5.6cqi, 76px); line-height: 1.04; letter-spacing: -0.02em">Custom glass &amp; mirrors in <em>{town}</em></h1>
          <p style="margin: 0 0 28px; font-size: clamp(17px, 1.5cqi, 20px); color: #E6EEF1; max-width: 540px">{lede}</p>
          <div style="display: flex; flex-wrap: wrap; gap: 12px">
            <a href="#estimate" style="display: inline-flex; align-items: center; height: 56px; padding: 0 28px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Get Free Estimate</a>
            <a href="tel:+15086852770" style="display: inline-flex; align-items: center; height: 56px; padding: 0 24px; border: 1px solid rgba(255,255,255,0.7); color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">(508) 685-2770</a>
          </div>
        </div>
        <div style="flex: 0 1 360px; min-width: 0; padding: 24px 28px; background: rgba(255,255,255,0.12); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border: 1px solid rgba(255,255,255,0.3)">
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px">
            <div><div style="font-family: 'Newsreader', Georgia, serif; font-size: 40px; line-height: 1">{statNum}</div><div style="font-size: 13px; color: #DCE6EA; margin-top: 6px">{statLabel}</div></div>
            <div><div style="font-family: 'Newsreader', Georgia, serif; font-size: 40px; line-height: 1">30+</div><div style="font-size: 13px; color: #DCE6EA; margin-top: 6px">Years on the Cape</div></div>
          </div>
          <div style="border-top: 1px solid rgba(255,255,255,0.25); margin-top: 20px; padding-top: 16px; font-size: 14px; color: #E6EEF1">{consult}</div>
        </div>
      </div>
    </div>
      </section>

  <!-- ===== LOCAL INTRO ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 40px 80px">
      <div style="flex: 1.3 1 520px; min-width: 0">
        <h2 style="margin: 0 0 24px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">{introH}</h2>
        <p style="margin: 0 0 16px; font-size: 18px; color: #26394A">{intro}</p>
        <p style="margin: 0; color: #4A5C67">{local}</p>
      </div>
      <div style="flex: 1 1 340px; min-width: 0; border: 1px solid #D6E0E4; padding: 28px; align-self: flex-start">
        <div style="font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: #4A5C67; margin-bottom: 8px">{town} at a glance</div>
        <div style="display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid #D6E0E4"><span style="color: #4A5C67">From our shop</span><span style="font-weight: 600">{drive}</span></div>
        <div style="display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid #D6E0E4"><span style="color: #4A5C67">Includes</span><span style="font-weight: 600; text-align: right">{villages}</span></div>
        <div style="display: flex; justify-content: space-between; gap: 16px; padding: 12px 0"><span style="color: #4A5C67">Consultation</span><span style="font-weight: 600; text-align: right">Free, on site</span></div>
      </div>
    </div>
  </section>

  <!-- ===== SERVICES IN TOWN ===== -->
  <section style="background: #F4F7F8">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Services in {town}</div>
      <h2 style="margin: 14px 0 clamp(28px, 4cqi, 44px); font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">Everything we do, in your town</h2>
      <div style={`display: grid; grid-template-columns: repeat(auto-fit, minmax(var(--svcMin), 1fr)); gap: 1px; background: #D6E0E4; border: 1px solid #D6E0E4`}>
        {services.map((s) => (<Fragment>
          <a href={link(s.href)} style="display: flex; align-items: center; gap: 14px; padding: 18px 20px; background: #FFFFFF; color: #0F2433; text-decoration: none">
            <span style={`width: 44px; height: 44px; flex: none; display: flex; align-items: center; justify-content: center; background: #E4EEF0; color: ${brand}`}><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d={s.d}></path></svg></span>
            <span style="flex: 1; font-size: 16px; font-weight: 600; line-height: 1.3">{s.name}</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="1.8" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg>
          </a>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== LOCAL PROJECTS ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <div style="display: flex; flex-wrap: wrap; gap: 16px 40px; align-items: flex-end; justify-content: space-between; margin-bottom: clamp(28px, 4cqi, 44px)">
        <div>
          <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Local work</div>
          <h2 style="margin: 14px 0 0; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">Recent projects from our team</h2>
        </div>
        <a href="/project-gallery/" style={`display: inline-flex; align-items: center; height: 44px; color: ${brand}; text-decoration: none; font-weight: 600; font-size: 15px; border-bottom: 1px solid currentColor`}>All projects</a>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: clamp(10px, 1.6cqi, 20px)">
        {projects.map((g) => (<Fragment>
          <a href="/project-gallery/" style={`display: block; position: relative; height: clamp(260px, 28cqi, 360px); overflow: hidden; border-radius: 2px; background-color: ${g.tone}; color: #FFFFFF; text-decoration: none`}>
            <img src={g.img} alt={g.title} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover" loading="lazy" decoding="async" />
            <span style="position: absolute; left: 12px; right: 12px; bottom: 12px; padding: 12px 16px; background: rgba(15,36,51,0.55); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.25)"><span style="display: block; font-size: 15px; font-weight: 600">{g.title}</span><span style="font-size: 13px; opacity: 0.9">{g.cat} · {g.town}</span></span>
          </a>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== REVIEWS ===== -->
  <section style="background: #E4EEF0">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <h2 style="margin: 0 0 clamp(28px, 4cqi, 44px); font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">What our clients say</h2>
      <div style="display: flex; gap: 20px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px">
        {reviews.map((r) => (<Fragment>
          <figure style="flex: 1 0 300px; scroll-snap-align: start; margin: 0; padding: 28px; background: #FFFFFF; border: 1px solid #D6E0E4; display: flex; flex-direction: column; gap: 14px">
            <span style="color: #9C7430; letter-spacing: 2px; font-size: 16px" role="img" aria-label="5 out of 5 stars">★★★★★</span>
            <blockquote style="margin: 0; flex: 1; font-family: 'Newsreader', Georgia, serif; font-size: 20px; line-height: 1.45">“{r.quote}”</blockquote>
            <figcaption style="font-size: 14px"><strong style="font-weight: 600">{r.name}</strong><span style="color: #4A5C67"> · {r.meta}</span></figcaption>
          </figure>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- ===== NEARBY + MAP ===== -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 40px 64px">
      <div style="flex: 1 1 420px; min-width: 0">
        <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Nearby areas</div>
        <h2 style="margin: 14px 0 28px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(30px, 3.2cqi, 40px); line-height: 1.15">Also serving {regionThe}</h2>
        <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px">
          {nearby.map((t) => (<Fragment>
            <a href={link(t.href)} style="display: flex; flex-direction: column; padding: 16px 18px; border: 1px solid #D6E0E4; border-radius: 2px; color: #0F2433; text-decoration: none">
              <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #4A5C67">{t.region}</span>
              <span style="display: flex; justify-content: space-between; align-items: center"><span style="font-family: 'Newsreader', Georgia, serif; font-size: 22px; font-weight: 500">{t.name}</span><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
            </a>
          </Fragment>))}
        </div>
      </div>
      <div style="flex: 1.2 1 440px; min-width: 0; min-height: 340px; position: relative; background-color: #E4EEF0; background-image: linear-gradient(0deg, rgba(255,255,255,0.9) 2px, transparent 2px), linear-gradient(90deg, rgba(255,255,255,0.9) 2px, transparent 2px); background-size: 72px 72px; border: 1px solid #D6E0E4">
        <div style="position: absolute; left: 28%; top: 58%; display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600"><span style="width: 12px; height: 12px; background: #0F2433"></span>Our shop · Hyannis</div>
        <div style={`position: absolute; left: ${mapX}; top: ${mapY}; transform: translate(-50%, -100%); display: flex; flex-direction: column; align-items: center; gap: 4px`}><span style={`padding: 5px 10px; background: ${brand}; color: #FFFFFF; font-size: 13px; font-weight: 600`}>{town}</span><svg width="28" height="28" viewBox="0 0 24 24" fill={brand} stroke="#FFFFFF" stroke-width="1.2" aria-hidden="true"><path d="M12 22s-7-6.2-7-12a7 7 0 0 1 14 0c0 5.8-7 12-7 12z"></path></svg></div>
        <span style="position: absolute; left: 12px; bottom: 10px; font-size: 11px; color: #4A5C67">Map · service area centered on {town}</span>
      </div>
    </div>
  </section>

  <!-- ===== CTA ===== -->
  <section id="estimate" style="background: #0F2433; color: #FFFFFF">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 7cqi, 96px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 28px 64px; align-items: center; justify-content: space-between">
      <div style="flex: 1 1 520px; min-width: 0">
        <h2 style="margin: 0 0 12px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 4cqi, 52px); line-height: 1.1">Planning a project in {town}?</h2>
        <p style="margin: 0; color: #B9C9D1; font-size: 18px">We’ll come to you for a free consultation and measure.</p>
      </div>
      <div style="display: flex; flex-wrap: wrap; gap: 12px">
        <a href="/get-free-estimate/" style="display: inline-flex; align-items: center; height: 56px; padding: 0 28px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Get Free Estimate</a>
        <a href="tel:+15086852770" style="display: inline-flex; align-items: center; height: 56px; padding: 0 24px; border: 1px solid rgba(255,255,255,0.7); color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Call (508) 685-2770</a>
      </div>
    </div>
  </section>

  <Footer />

  <div class="dc-m">
    <div style="position: sticky; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1.35fr; gap: 8px; padding: 10px 12px 12px; background: rgba(255,255,255,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid #D6E0E4">
      <a href="tel:+15086852770" style="display: flex; align-items: center; justify-content: center; gap: 8px; height: 52px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg>Call now</a>
      <a href="/get-free-estimate/" style={`display: flex; align-items: center; justify-content: center; height: 52px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px`}>Get Free Estimate</a>
    </div>
  </div>
</div>

<style>
  .dc-root {
    --svcMin: 280px;
  }
  @media (max-width: 759.98px) {
    .dc-root {
      --svcMin: 100%;
    }
  }
</style>
