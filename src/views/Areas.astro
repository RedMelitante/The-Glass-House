---
import Header from '../components/Header.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { link } from '../lib/routes';
import { areasData } from '../data/areas.js';

const { brand, pins, regions } = areasData(Astro.props);
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <!-- HERO + MAP -->
  <section style="background: #F4F7F8; border-bottom: 1px solid #D6E0E4">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(20px, 2.4cqi, 28px) clamp(20px, 4cqi, 48px) clamp(48px, 6cqi, 80px)">
      <nav aria-label="Breadcrumb" style="font-size: 13px; color: #4A5C67; margin-bottom: clamp(24px, 4cqi, 48px)"><a href="/" style="color: #4A5C67">Home</a><span style="margin: 0 8px">/</span><span aria-current="page" style="color: #0F2433; font-weight: 500">Areas we serve</span></nav>
      <div style="display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: center">
        <div style="flex: 1 1 420px; min-width: 0">
          <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Areas we serve · 19 towns</div>
          <h1 style="margin: 14px 0 16px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(40px, 5.2cqi, 68px); line-height: 1.04; letter-spacing: -0.02em">From the Canal to Provincetown, and over the bridge</h1>
          <p style="margin: 0 0 24px; font-size: 18px; color: #26394A">Based in Hyannis and serving all of Barnstable County, Southeastern Massachusetts and select areas of Rhode Island.</p>
          <label for="town-search" style="display: block; font-size: 14px; font-weight: 600; margin-bottom: 6px">Find your town</label>
          <form role="search" data-town-search action="/glassworks-areas-we-serve/" style="display: flex; gap: 8px; max-width: 460px">
            <input id="town-search" type="search" autocomplete="off" placeholder="e.g. Wellfleet" style="flex: 1; min-width: 0; height: 52px; padding: 0 16px; border: 1px solid #B7C6CD; border-radius: 2px; font: inherit; font-size: 16px; background: #FFFFFF" />
            <button type="submit" style="height: 52px; padding: 0 20px; background: #0F2433; color: #FFFFFF; border: 0; border-radius: 2px; font: inherit; font-weight: 600; cursor: pointer">Search</button>
          </form>
        </div>
        <div style="flex: 1.2 1 460px; min-width: 0; height: clamp(300px, 34cqi, 440px); position: relative; background-color: #E4EEF0; background-image: linear-gradient(0deg, rgba(255,255,255,0.9) 2px, transparent 2px), linear-gradient(90deg, rgba(255,255,255,0.9) 2px, transparent 2px); background-size: 64px 64px; border: 1px solid #D6E0E4">
          {pins.map((p) => (<Fragment>
            <span style={`position: absolute; left: ${p.x}; top: ${p.y}; display: flex; align-items: center; gap: 5px; font-size: 12px; font-weight: 600; white-space: nowrap`}><span style={`width: 10px; height: 10px; border-radius: 50%; background: ${p.dot}; border: 2px solid #FFFFFF`}></span>{p.name}</span>
          </Fragment>))}
          <span style="position: absolute; left: 12px; bottom: 10px; font-size: 11px; color: #4A5C67">Interactive service-area map (Google Maps)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- REGIONS -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(56px, 8cqi, 104px) clamp(20px, 4cqi, 48px); display: flex; flex-direction: column; gap: clamp(40px, 5cqi, 64px)">
      {regions.map((r) => (<Fragment>
        <div data-region style="display: flex; flex-wrap: wrap; gap: 20px 48px">
          <div style="flex: 0 1 260px; min-width: 0">
            <h2 style="margin: 0 0 6px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(28px, 2.8cqi, 36px); line-height: 1.15">{r.name}</h2>
            <p style="margin: 0; font-size: 15px; color: #4A5C67">{r.note}</p>
          </div>
          <div style={`flex: 1 1 520px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--townMin), 1fr)); gap: 12px`}>
            {r.towns.map((t) => (<Fragment>
              <a href={link(t.href)} data-town={t.name} style="display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 18px 18px; border: 1px solid #D6E0E4; border-radius: 2px; color: #0F2433; text-decoration: none; background: #FFFFFF">
                <span style="font-family: 'Newsreader', Georgia, serif; font-size: 22px; font-weight: 500">{t.name}</span>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="1.8" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
              </a>
            </Fragment>))}
          </div>
        </div>
      </Fragment>))}
      <div data-no-town style="padding: 24px 28px; border: 1px dashed #8FA3AD; display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between">
        <span style="font-size: 17px"><strong style="font-weight: 600">Don’t see your town?</strong> <span style="color: #4A5C67">We often travel for the right project. Just ask.</span></span>
        <a href="tel:+15086852770" style="display: inline-flex; align-items: center; height: 48px; padding: 0 22px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px">Call (508) 685-2770</a>
      </div>
    </div>
  </section>

  <CtaBand heading="Wherever you are on the Cape, we’ll come to you." sub="Free on-site consultations and estimates." />
  <Footer />

  <div class="dc-m">
    <div style="position: sticky; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1.35fr; gap: 8px; padding: 10px 12px 12px; background: rgba(255,255,255,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid #D6E0E4">
      <a href="tel:+15086852770" style="display: flex; align-items: center; justify-content: center; height: 52px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Call now</a>
      <a href="/get-free-estimate/" style={`display: flex; align-items: center; justify-content: center; height: 52px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px`}>Get Free Estimate</a>
    </div>
  </div>
</div>

<style>
  .dc-root {
    --townMin: 200px;
  }
  @media (max-width: 759.98px) {
    .dc-root {
      --townMin: 140px;
    }
  }
</style>

<script>
  // "Find your town": filters the town cards as you type; Enter opens the page for a single match.
  const form = document.querySelector<HTMLFormElement>('[data-town-search]');
  const input = document.querySelector<HTMLInputElement>('#town-search');
  const towns = [...document.querySelectorAll<HTMLAnchorElement>('[data-town]')];
  const regions = [...document.querySelectorAll<HTMLElement>('[data-region]')];
  const matches = () => {
    const q = (input?.value ?? '').trim().toLowerCase();
    return towns.filter((a) => a.dataset.town!.toLowerCase().includes(q));
  };
  input?.addEventListener('input', () => {
    const hits = new Set(matches());
    towns.forEach((a) => (a.hidden = !hits.has(a)));
    regions.forEach((r) => (r.hidden = !r.querySelector('[data-town]:not([hidden])')));
  });
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const hits = matches();
    const exact = hits.find((a) => a.dataset.town!.toLowerCase() === input!.value.trim().toLowerCase());
    const target = exact ?? (hits.length === 1 ? hits[0] : null);
    if (target) window.location.href = target.href;
    else document.querySelector('[data-region]:not([hidden])')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
