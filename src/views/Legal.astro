---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { legalData } from '../data/legal.js';

interface Props {
  doc: 'privacy' | 'terms';
}

const { doc: key } = Astro.props;
const { brand, doc, tabs } = legalData({}, { doc: key });
// Each document has its own URL, so the tabs are links.
const tabHref: Record<string, string> = { 'Privacy Policy': '/privacy-policy/', 'Terms & Conditions': '/terms-and-conditions/' };
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <section style="background: #F4F7F8; border-bottom: 1px solid #D6E0E4">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(20px, 2.4cqi, 28px) clamp(20px, 4cqi, 48px) 0">
      <nav aria-label="Breadcrumb" style="font-size: 13px; color: #4A5C67; margin-bottom: clamp(24px, 4cqi, 44px)"><a href="/" style="color: #4A5C67">Home</a><span style="margin: 0 8px">/</span><span aria-current="page" style="color: #0F2433; font-weight: 500">{doc.title}</span></nav>
      <h1 style="margin: 0 0 8px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(38px, 4.8cqi, 64px); line-height: 1.05">{doc.title}</h1>
      <p style="margin: 0 0 28px; font-size: 15px; color: #4A5C67">Last updated {doc.updated}</p>
      <nav aria-label="Legal documents" style="display: flex; gap: 4px; overflow-x: auto">
        {tabs.map((t) => (<Fragment>
          <a href={tabHref[t.label]} aria-current={t.on ? 'page' : undefined} style={`flex: none; display: inline-flex; align-items: center; box-sizing: border-box; height: 48px; padding: 0 18px; border: 0; border-bottom: 2px solid ${t.line}; background: transparent; font: inherit; font-size: 15px; font-weight: 600; color: ${t.color}; text-decoration: none; cursor: pointer`}>{t.label}</a>
        </Fragment>))}
      </nav>
    </div>
  </section>

  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 6cqi, 72px) clamp(20px, 4cqi, 48px) clamp(64px, 8cqi, 104px); display: flex; flex-wrap: wrap; gap: 32px 80px; align-items: flex-start">
      <div class="dc-d">
        <nav aria-label="On this page" style="flex: 0 0 240px; position: sticky; top: 152px; border-left: 1px solid #D6E0E4">
          {doc.sections.map((s) => (<Fragment>
            <a href={`#${s.id}`} style="display: block; padding: 6px 0 6px 16px; font-size: 14px; color: #4A5C67; text-decoration: none">{s.h}</a>
          </Fragment>))}
        </nav>
      </div>
      <article style="flex: 1 1 560px; min-width: 0; max-width: 720px; font-size: 17px; line-height: 1.75; color: #26394A">
        {doc.draft ? (<Fragment>
          <div style="padding: 16px 20px; background: #FFF8E6; border: 1px solid #E8D5A8; font-size: 14px; color: #5C4718; margin-bottom: 32px">Template layout. Final legal text to be supplied or approved by the client or their counsel.</div>
        </Fragment>) : null}
        {doc.sections.map((s) => (<Fragment>
          <div id={s.id} style="margin-bottom: 32px">
            <h2 style="margin: 0 0 10px; font-family: 'Newsreader', Georgia, serif; font-weight: 500; font-size: 26px; color: #0F2433">{s.h}</h2>
            {s.blocks.map((b) => (<Fragment>
              {b.isSub ? (<Fragment>
                <h3 style="margin: 18px 0 6px; font-size: 17px; font-weight: 600; color: #0F2433">{b.text}</h3>
              </Fragment>) : null}
              {b.isP ? (<Fragment>
                <p style="margin: 0 0 12px">{b.text}</p>
              </Fragment>) : null}
              {b.isList ? (<Fragment>
                <ul style="margin: 0 0 14px; padding-left: 22px; display: flex; flex-direction: column; gap: 4px">
                  {b.items.map((li) => (<Fragment>
                    <li>{li}</li>
                  </Fragment>))}
                </ul>
              </Fragment>) : null}
            </Fragment>))}
          </div>
        </Fragment>))}
        <div style="margin-top: 40px; padding: 24px; border: 1px solid #D6E0E4">
          <div style="font-weight: 600; color: #0F2433; margin-bottom: 6px">Questions about this policy?</div>
          <div style="font-size: 15px">The Glass House · 270 Communication Way, Hyannis, MA 02601 · <a href="mailto:ornyb@theghglass.com" style={`color: ${brand}`}>ornyb@theghglass.com</a> · <a href="tel:+15086852770" style={`color: ${brand}`}>(508) 685-2770</a></div>
        </div>
      </article>
    </div>
  </section>

  <Footer />

  <div class="dc-m">
    <div style="position: sticky; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1.35fr; gap: 8px; padding: 10px 12px 12px; background: rgba(255,255,255,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid #D6E0E4">
      <a href="tel:+15086852770" style="display: flex; align-items: center; justify-content: center; height: 52px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Call now</a>
      <a href="/get-free-estimate/" style={`display: flex; align-items: center; justify-content: center; height: 52px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px`}>Get Free Estimate</a>
    </div>
  </div>
</div>
