---
import Header from '../components/Header.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import { link } from '../lib/routes';
import { servicesData } from '../data/services.js';

const { brand, count, tabs, services, steps } = servicesData(Astro.props);

// Residential / Commercial tabs filter the grid client-side (scripts/filter.ts).
const tabBase = 'height: 44px; padding: 0 18px; border: 0; font: inherit; font-size: 14px; font-weight: 600; cursor: pointer';
const tabOn = tabs.find((t) => t.on)?.style;
const tabOff = tabs.find((t) => !t.on)?.style;
---
<div class="dc-root" style="container-type: inline-size; background: #FFFFFF; color: #0F2433; font-family: 'Instrument Sans', system-ui, sans-serif; font-size: 16px; line-height: 1.6">

  <div style="position: sticky; top: 0; z-index: 50">
    <Header />
  </div>

  <!-- HERO -->
  <section style="background: #F4F7F8; border-bottom: 1px solid #D6E0E4">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(20px, 2.4cqi, 28px) clamp(20px, 4cqi, 48px) clamp(48px, 6cqi, 80px)">
      <nav aria-label="Breadcrumb" style="font-size: 13px; color: #4A5C67; margin-bottom: clamp(24px, 4cqi, 48px)"><a href="/" style="color: #4A5C67">Home</a><span style="margin: 0 8px">/</span><span aria-current="page" style="color: #0F2433; font-weight: 500">Glass services</span></nav>
      <div style="display: flex; flex-wrap: wrap; gap: 32px 64px; align-items: flex-end; justify-content: space-between">
        <div style="flex: 1 1 600px; min-width: 0">
          <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>Glass services · 12 specialties</div>
          <h1 style="margin: 14px 0 16px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(40px, 5.4cqi, 72px); line-height: 1.04; letter-spacing: -0.02em">Custom glass, designed &amp; installed on the Cape</h1>
          <p style="margin: 0; font-size: 18px; color: #26394A; max-width: 620px">One local team for design, measuring, fabrication and installation, for homes, builders and businesses across Cape Cod, Southeastern MA and Rhode Island.</p>
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 12px">
          <a href="/get-free-estimate/" style={`display: inline-flex; align-items: center; height: 56px; padding: 0 28px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px`}>Get Free Estimate</a>
          <a href="tel:+15086852770" style="display: inline-flex; align-items: center; height: 56px; padding: 0 24px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">(508) 685-2770</a>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICE GRID -->
  <section>
    <div data-filter-root data-active="All" style="max-width: 1240px; margin: 0 auto; padding: clamp(40px, 6cqi, 72px) clamp(20px, 4cqi, 48px) clamp(64px, 9cqi, 120px)">
      <div style="display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; margin-bottom: clamp(24px, 3cqi, 36px)">
        <div role="radiogroup" aria-label="Filter services" style="display: inline-grid; grid-template-columns: repeat(3, auto); border: 1px solid #B7C6CD; border-radius: 2px; overflow: hidden">
          {tabs.map((t) => (<Fragment>
            <button type="button" role="radio" aria-checked={t.on ? 'true' : 'false'} data-filter={t.label} data-style-base={tabBase} data-style-on={tabOn} data-style-off={tabOff} style={`${tabBase}; ${t.style}`}>{t.label}</button>
          </Fragment>))}
        </div>
        <span style="font-size: 14px; color: #4A5C67"><span data-filter-count>{count}</span> services</span>
      </div>
      <div style={`display: grid; grid-template-columns: repeat(auto-fill, minmax(var(--cardMin), 1fr)); gap: clamp(12px, 2cqi, 24px)`}>
        {services.map((s) => (<Fragment>
          <a href={link(s.href)} data-filter-item data-cat={[s.r && 'Residential', s.c && 'Commercial'].filter(Boolean).join('|')} style="display: flex; flex-direction: column; border: 1px solid #D6E0E4; border-radius: 2px; color: #0F2433; text-decoration: none; background: #FFFFFF">
            <span style={`position: relative; height: var(--photoH); background-color: ${s.tone}; background-image: repeating-linear-gradient(118deg, rgba(255,255,255,0) 0 70px, rgba(255,255,255,0.4) 70px 72px)`}>
              {s.hasImg ? (<Fragment><img src={s.img} alt={`${s.name} project`} style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover" loading="lazy" decoding="async" /></Fragment>) : null}
              <span style={`position: absolute; left: 16px; bottom: -22px; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: #FFFFFF; border: 1px solid #D6E0E4; color: ${brand}`}><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d={s.d}></path></svg></span>
            </span>
            <span style="padding: 34px 18px 20px; display: flex; flex-direction: column; gap: 6px; flex: 1">
              <span style="font-size: 18px; font-weight: 600; line-height: 1.3">{s.name}</span>
              <div class="dc-d"><span style="font-size: 14px; color: #4A5C67; line-height: 1.5">{s.blurb}</span></div>
              <span style="margin-top: auto; padding-top: 8px; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #4A5C67">{s.tags}</span>
            </span>
          </a>
        </Fragment>))}
      </div>
    </div>
  </section>

  <!-- TRADE -->
  <section style="background: #E4EEF0">
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 8cqi, 104px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 40px 80px; align-items: center">
      <div style="flex: 1 1 460px; min-width: 0">
        <div style={`font-size: 12px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: ${brand}`}>For builders &amp; architects</div>
        <h2 style="margin: 14px 0 16px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">A glass partner that shows up on schedule</h2>
        <p style="margin: 0 0 28px; font-size: 17px; color: #26394A">Many of our clients are Cape builders and contractors who send us job after job. We coordinate with your schedule, measure after tile or framing, and keep one point of contact from bid to install.</p>
        <a href="/contact/" style="display: inline-flex; align-items: center; height: 52px; padding: 0 24px; background: #0F2433; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 15px; border-radius: 2px">Trade inquiries</a>
      </div>
      <ul style="flex: 1 1 380px; min-width: 0; list-style: none; margin: 0; padding: 0; border-top: 1px solid #0F2433">
        <li style="display: flex; gap: 14px; padding: 18px 0; border-bottom: 1px solid #C9D6DB"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="2" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="M20 6L9 17l-5-5"></path></svg><span><strong style="font-weight: 600">Bids from your plans</strong><br /><span style="color: #4A5C67; font-size: 15px">Send drawings, get a written quote.</span></span></li>
        <li style="display: flex; gap: 14px; padding: 18px 0; border-bottom: 1px solid #C9D6DB"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="2" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="M20 6L9 17l-5-5"></path></svg><span><strong style="font-weight: 600">Site coordination</strong><br /><span style="color: #4A5C67; font-size: 15px">Measure and install around your trades.</span></span></li>
        <li style="display: flex; gap: 14px; padding: 18px 0; border-bottom: 1px solid #C9D6DB"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke={brand} stroke-width="2" aria-hidden="true" style="flex: none; margin-top: 3px"><path d="M20 6L9 17l-5-5"></path></svg><span><strong style="font-weight: 600">Commercial experience</strong><br /><span style="color: #4A5C67; font-size: 15px">Storefronts, entrances, partitions, gyms.</span></span></li>
      </ul>
    </div>
  </section>

  <!-- PROCESS -->
  <section>
    <div style="max-width: 1240px; margin: 0 auto; padding: clamp(64px, 9cqi, 120px) clamp(20px, 4cqi, 48px)">
      <h2 style="margin: 0 0 clamp(32px, 4cqi, 56px); font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 3.6cqi, 48px); line-height: 1.15; letter-spacing: -0.01em">How every project works</h2>
      <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px">
        {steps.map((s) => (<Fragment>
          <li style="padding-top: 24px; border-top: 2px solid #0F2433">
            <div style="font-family: 'Newsreader', Georgia, serif; font-size: 48px; line-height: 1; color: #9C7430; margin-bottom: 16px">{s.n}</div>
            <div style="font-size: 19px; font-weight: 600; margin-bottom: 6px">{s.title}</div>
            <div style="font-size: 15px; color: #4A5C67">{s.text}</div>
          </li>
        </Fragment>))}
      </ol>
    </div>
  </section>

  <CtaBand heading="Not sure which service you need?" sub="Book a free design consultation. We’ll visit, measure and recommend the right glass." />
  <Footer />

  <div class="dc-m">
    <div style="position: sticky; bottom: 0; z-index: 60; display: grid; grid-template-columns: 1fr 1.35fr; gap: 8px; padding: 10px 12px 12px; background: rgba(255,255,255,0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid #D6E0E4">
      <a href="tel:+15086852770" style="display: flex; align-items: center; justify-content: center; height: 52px; border: 1px solid #0F2433; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Call now</a>
      <a href="/get-free-estimate/" style={`display: flex; align-items: center; justify-content: center; height: 52px; background: ${brand}; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px`}>Get Free Estimate</a>
    </div>
  </div>
</div>

<style>
  .dc-root {
    --cardMin: 260px;
    --photoH: 170px;
  }
  @media (max-width: 759.98px) {
    .dc-root {
      --cardMin: 150px;
      --photoH: 110px;
    }
  }
</style>
