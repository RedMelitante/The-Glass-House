---
import BaseLayout from '../layouts/BaseLayout.astro';
import Blog from '../views/Blog.astro';
import { render } from 'astro:content';
import { card, getPosts, postImage, postUrl } from '../lib/blog';
import { SITE } from '../lib/site';

// Blog posts live at the site root, the same URLs they had on WordPress.
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => {
    const sameCat = posts.filter((p) => p.id !== post.id && p.data.categories.some((c) => post.data.categories.includes(c)));
    const others = posts.filter((p) => p.id !== post.id && !sameCat.includes(p));
    return { params: { slug: post.id }, props: { post, related: [...sameCat, ...others].slice(0, 3).map(card) } };
  });
}

const { post, related } = Astro.props;
const { headings } = await render(post);
const html = post.rendered?.html ?? '';
const url = new URL(postUrl(post), Astro.site).href;
const image = postImage(post);

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  image: new URL(image, Astro.site).href,
  datePublished: post.data.pubDate.toISOString(),
  author: { '@type': 'Person', name: post.data.author },
  publisher: { '@id': `${SITE.url}/#business` },
  mainEntityOfPage: url,
};
---
<BaseLayout
  title={`${post.data.title} | The Glass House`}
  description={post.data.description}
  image={image}
  type="article"
  schema={articleSchema}
>
  <meta slot="head" property="article:published_time" content={post.data.pubDate.toISOString()} />
  <Blog post={post} html={html} headings={headings} related={related} />
</BaseLayout>
