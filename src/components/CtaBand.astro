---
import { ctaBandData } from '../data/ctaBand.js';

const { heading, sub } = ctaBandData(Astro.props);
---
<section style="container-type: inline-size; background: #0F2433; color: #FFFFFF; font-family: 'Instrument Sans', system-ui, sans-serif; line-height: 1.6; position: relative; overflow: hidden">
  <svg width="420" height="420" viewBox="0 0 520 520" fill="none" aria-hidden="true" style="position: absolute; right: -90px; top: -70px; opacity: 0.1"><rect x="0.5" y="0.5" width="300" height="420" stroke="#FFFFFF"></rect><rect x="160.5" y="80.5" width="300" height="420" stroke="#FFFFFF"></rect><path d="M60 380L260 180M120 440L320 240" stroke="#C79A4B"></path></svg>
  <div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(56px, 7cqi, 96px) clamp(20px, 4cqi, 48px); display: flex; flex-wrap: wrap; gap: 28px 64px; align-items: center; justify-content: space-between">
    <div style="flex: 1 1 520px; min-width: 0">
      <h2 style="margin: 0 0 12px; font-family: 'Newsreader', Georgia, serif; font-weight: 400; font-size: clamp(32px, 4cqi, 52px); line-height: 1.1">{heading}</h2>
      <p style="margin: 0; color: #B9C9D1; font-size: 18px">{sub}</p>
    </div>
    <div style="display: flex; flex-wrap: wrap; gap: 12px">
      <a href="/get-free-estimate/" style="display: inline-flex; align-items: center; height: 56px; padding: 0 28px; background: #FFFFFF; color: #0F2433; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Get Free Estimate</a>
      <a href="tel:+15086852770" style="display: inline-flex; align-items: center; height: 56px; padding: 0 24px; border: 1px solid rgba(255,255,255,0.7); color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; border-radius: 2px">Call (508) 685-2770</a>
    </div>
  </div>
</section>
